import { test } from "node:test";
import assert from "node:assert/strict";
import { classifyFile, extractTopics, offlineMessage, offlineMessages } from "../lib/offline.js";
import { buildPrompt, cleanResponse } from "../lib/providers.js";

const SAMPLE_DIFF = `diff --git a/src/userService.js b/src/userService.js
new file mode 100644
index 0000000..e69de29
--- /dev/null
+++ b/src/userService.js
@@ -0,0 +1,10 @@
+import { db } from "./db.js";
+
+export async function fetchUserById(userId) {
+  return db.users.find(userId);
+}
+
+export async function updateUserProfile(userProfile, patch) {
+  return db.users.update(userProfile.id, patch);
+}
`;

test("classifyFile maps paths to conventional types", () => {
  assert.equal(classifyFile("src/userService.js"), "feat");
  assert.equal(classifyFile("tests/user.test.js"), "test");
  assert.equal(classifyFile("docs/README.md"), "docs");
  assert.equal(classifyFile(".github/workflows/ci.yml"), "ci");
  assert.equal(classifyFile("package.json"), "chore(deps)");
  assert.equal(classifyFile("packages/app/package-lock.json"), "chore(deps)");
});

test("extractTopics prefers identifiers from changed lines", () => {
  const topics = extractTopics(SAMPLE_DIFF);
  assert.ok(topics.includes("user"), `topics: ${topics}`);
  assert.ok(topics.some((t) => ["fetchuserbyid", "updateuserprofile"].includes(t)), `topics: ${topics}`);
});

test("offlineMessage produces a conventional commit", () => {
  const msg = offlineMessage(SAMPLE_DIFF, ["src/userService.js"], {});
  assert.match(msg, /^feat: /);
  assert.ok(msg.length < 100);
});

test("offlineMessage handles dependency-only changes", () => {
  const msg = offlineMessage("+\"left-pad\": \"1.3.0\"", ["package.json"], {});
  assert.match(msg, /^chore\(deps\): update dependencies/);
});

test("offlineMessages respects count", () => {
  const msgs = offlineMessages(SAMPLE_DIFF, ["src/userService.js"], 3, {});
  assert.ok(msgs.length >= 1 && msgs.length <= 3);
  assert.equal(new Set(msgs).size, msgs.length);
});

test("offlineMessage returns null for empty file list", () => {
  assert.equal(offlineMessage("", [], {}), null);
});

test("buildPrompt includes diff and system rules", () => {
  const cfg = { locale: "en", maxSubjectLength: 60 };
  const p = buildPrompt(SAMPLE_DIFF, ["a.js"], cfg, ["chore: init"]);
  assert.match(p.system, /Conventional Commits/);
  assert.match(p.user, /```diff/);
  assert.match(p.user, /chore: init/);
});

test("cleanResponse strips code fences and quotes", () => {
  assert.equal(cleanResponse('```bash\n"feat: add x"\n```'), "feat: add x");
  assert.equal(cleanResponse("Here is the commit message:\n\nfeat: add x"), "feat: add x");
  assert.equal(cleanResponse("feat: add x"), "feat: add x");
});
